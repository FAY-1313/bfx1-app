# ─────────────────────────────────────────────────────────────
# ★ 2026-11-07：为 iOS CI（GitHub Actions）瘦身
#   · 只忽略「构建产物 / 本机配置」，src、public（179MB 的模型与音频）、
#     ios 原生工程、android 源码都必须进仓库，否则 CI 构建出来的 App 会缺资源。
#   · 单文件上限 100MB —— public 下最大文件 26.5MB，安全。
# ─────────────────────────────────────────────────────────────
# iOS 构建产物（由 npm run build + npx cap sync ios 重新生成）
ios/App/App/public
ios/App/App/capacitor.config.json
ios/App/build
ios/capacitor-cordova-ios-plugins
*.ipa

# Android 构建产物与本机 SDK 路径
android/app/build
android/build
android/.gradle
android/capacitor-cordova-android-plugins
android/local.properties

# 本机临时 / 备份 / 验证输出
_tmp
_verify
src_backup_*
*.apk

# ─────────────────────────────────────────────────────────────
# ★ 2026-11-19：正式签名密钥（应用宝等安卓商店上架用）
#   仓库是 public —— 这两个文件含明文密码/私钥，提交一次等于公开泄露。
#   keystore 本体放在仓库外 C:/Users/FAY/bfx1-keystore/，这里再加一道保险。
android/keystore.properties
*.jks
*.keystore
