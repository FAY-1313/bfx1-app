# BFX-1 分轨服务 Caddy 配置 (自动 HTTPS)
# 域名通过环境变量 DOMAIN 注入 (deploy_lighthouse.sh 传入), 证书由 Caddy 自动申请/续期
# 前提: 域名 A 记录已解析到本机公网 IP, 且防火墙放行 80/443

{env.DOMAIN} {
    encode gzip

    # 上传限制 220MB (App 端单曲通常 <20MB, 但留足余量)
    request_body {
        max_size 220MB
    }

    # 分轨可能耗时数分钟, 关闭默认的代理缓冲/超时限制
    reverse_proxy app:8000 {
        flush_interval -1
    }
}
