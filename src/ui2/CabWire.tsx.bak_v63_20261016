/**
 * BFX1 箱体立体线框图（v5 · M3 · 2026-10-14）
 *
 * 用户要求：箱体区右侧画一个不同箱体的立体线框图，显示不同喇叭数量即可。
 * 喇叭布局从箱体名称解析（4x12 → 2×2、8x10 → 2×4、212C → 2×1、单只 → 1×1…），
 * 无法解析的名称走兜底表（D5 待产品确认的 6 个箱体默认 2×2）。
 *
 * 视觉：等轴测线框（金线 #e8b860 + 深底），与 ui2 暗色风格一致。
 */

/** 喇叭网格解析：n 个喇叭 → cols×rows */
export function speakerGrid(n: number): { cols: number; rows: number } {
  if (n <= 1) return { cols: 1, rows: 1 };
  const cols = n <= 2 ? 2 : n <= 4 ? 2 : 4;
  return { cols, rows: Math.ceil(n / cols) };
}

/** 箱体名 → 喇叭数量；known=false 表示兜底（待产品确认） */
export function cabSpeakerCount(name: string): { n: number; known: boolean } {
  const s = name || '';
  /* ── ① 显式 NxM（4x12 / 8x10 / 2x15 / 1x12 / 2x12 …）── */
  const m = s.match(/(\d+)\s*[x×]\s*(\d+)/i);
  if (m) return { n: Math.max(1, parseInt(m[1], 10) || 1), known: true };
  /* ── ② 紧凑写法 212C / 210 / 410 / 115 / PPC412 ── */
  const c = s.match(/\b(\d)(\d{2})\b/);           // 212 / 410 / 115
  if (c) {
    const speakers = parseInt(c[1], 10);
    if (speakers >= 1 && speakers <= 8) return { n: speakers, known: true };
  }
  if (/PPC\s*4\s*12/i.test(s)) return { n: 4, known: true };
  /* ── ③ 语义 ── */
  if (/单只|single/i.test(s)) return { n: 1, known: true };
  /* ── ④ 兜底表（按系列惯例；D5 待确认项）── */
  if (/1960/i.test(s)) return { n: 4, known: true };        // 1960 全系 4x12
  if (/Deluxe Reverb/i.test(s)) return { n: 1, known: true };
  if (/Super Reverb/i.test(s)) return { n: 4, known: true }; // 4x10
  if (/Twin/i.test(s)) return { n: 2, known: true };         // 2x12
  if (/Bassman/i.test(s)) return { n: 1, known: true };      // 1x15/1x12
  if (/Princeton|Champ/i.test(s)) return { n: 1, known: true };
  if (/AC\s*360|Acoustic 360/i.test(s)) return { n: 1, known: true };
  if (/SVT/i.test(s)) return { n: 8, known: true };          // 8x10
  if (/Eden DT410/i.test(s)) return { n: 4, known: true };
  if (/Recto 2x12|Orange 2x12|Bogner 212C/i.test(s)) return { n: 2, known: true };
  /* ── ⑤ 未知（Supro Cabs / 贝斯混合集 / Mesa Std OS 2012 / SVT 4x10+8x10 / Bassman '70 2x15 已含 x → 不会到这）── */
  return { n: 4, known: false };
}

interface Props {
  cabName: string;
  /** 宽度：数字 px 或 CSS 长度（如 min(100%, 46vw)）；高度按 0.8 比例自适应 */
  w?: number | string;
}

/** 等轴测箱体线框 + 喇叭点阵 */
export default function CabWire({ cabName, w = 150 }: Props) {
  const { n, known } = cabSpeakerCount(cabName);
  const { cols, rows } = speakerGrid(n);
  const wStyle = typeof w === 'number' ? `${w}px` : w;

  /* ── 等轴测箱体顶点（viewBox 120×96）── */
  const FX = 20, FY = 34, FW = 78, FH = 44, DX = 17, DY = 17;   // 前面 / 顶面偏移
  const front = `${FX},${FY} ${FX + FW},${FY} ${FX + FW},${FY + FH} ${FX},${FY + FH}`;
  const top   = `${FX},${FY} ${FX + DX},${FY - DY} ${FX + FW + DX},${FY - DY} ${FX + FW},${FY}`;
  const right = `${FX + FW},${FY} ${FX + FW + DX},${FY - DY} ${FX + FW + DX},${FY + FH - DY} ${FX + FW},${FY + FH}`;

  /* ── 喇叭圆点（前面网格居中）── */
  const padX = 13, padY = 11;
  const cellW = (FW - padX * 2) / cols;
  const cellH = (FH - padY * 2) / rows;
  const r = Math.max(2.6, Math.min(cellW, cellH) * 0.33);
  const dots: { cx: number; cy: number }[] = [];
  for (let ri = 0; ri < rows; ri++) {
    for (let ci = 0; ci < cols; ci++) {
      dots.push({
        cx: FX + padX + cellW * (ci + 0.5),
        cy: FY + padY + cellH * (ri + 0.5),
      });
    }
  }

  return (
    <svg viewBox="0 0 120 96" style={{ display: 'block', flexShrink: 0, width: wStyle, aspectRatio: '120 / 96' }}>
      {/* 三个面 */}
      <polygon points={top}   fill="rgba(232,184,96,0.05)" stroke="#e8b860" strokeWidth="1.1" strokeOpacity="0.85" />
      <polygon points={right} fill="rgba(232,184,96,0.03)" stroke="#e8b860" strokeWidth="1.1" strokeOpacity="0.6" />
      <polygon points={front} fill="rgba(10,12,16,0.55)"   stroke="#e8b860" strokeWidth="1.4" strokeOpacity="0.95" />
      {/* 顶部提手 */}
      <path d={`M ${FX + FW * 0.36} ${FY - DY * 0.55} q ${FW * 0.14} ${-DY * 0.5} ${FW * 0.28} 0`}
        fill="none" stroke="#e8b860" strokeWidth="1.2" strokeOpacity="0.8" />
      {/* 喇叭点阵 */}
      {dots.map((p, i) => (
        <g key={i}>
          <circle cx={p.cx} cy={p.cy} r={r} fill="rgba(232,184,96,0.10)" stroke="#e8b860" strokeWidth="1" strokeOpacity="0.9" />
          <circle cx={p.cx} cy={p.cy} r={r * 0.38} fill="none" stroke="#e8b860" strokeWidth="0.7" strokeOpacity="0.55" />
        </g>
      ))}
      {/* 角保护 */}
      {[[FX, FY], [FX + FW, FY], [FX, FY + FH], [FX + FW, FY + FH]].map(([x, y], i) => (
        <circle key={i} cx={x} cy={y} r="1.4" fill="#e8b860" fillOpacity="0.8" />
      ))}
      {/* 未知规格水印（D5） */}
      {!known && (
        <text x="60" y="91" textAnchor="middle" fontSize="6.5" fill="#9BA3B2">规格待确认</text>
      )}
    </svg>
  );
}
