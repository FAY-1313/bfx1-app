// ─── 官方单预设 ───
// 原 4 个: 内置 16 槽 (buildBuiltinPresets) 中取代表完整音色. 槽 1 = BYPASS_PRESET 空音色, 仅取槽 2-16.
const BANK = buildBuiltinPresets();
const singleFrom = (slot: number, name: string): LocalPreset => ({ ...BANK[slot - 1], slot: 0, name });

/** 新造单预设: 从组底座派生, 仅覆盖模块开关 + BOOST + 差异化旋钮 */
function rig(base: GroupBase, name: string, modules: Record<string, boolean>, boost?: number, knobsOverride?: Record<string, Record<string, number>>): LocalPreset {
  return buildGroupPreset(base, 0, name, modules, boost, knobsOverride);
}

export const OFFICIAL_TONES: OfficialToneSeed[] = [
  // ── 15 官方组 ──
  ...PACKS.map((p) => ({
    _id: `official-${p.id}`,
    kind: 'group' as const,
    name: p.name,
    description: p.desc,
    tags: p.tags,
    category: p.tones[0].playMode === 'bass' ? ('bass' as const) : ('guitar' as const),
