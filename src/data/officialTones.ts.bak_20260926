function buildPackTones(base: GroupBase, gains: Array<Record<string, Record<string, number>> | undefined>, names: [string, string, string, string], slots: Record<string, boolean>[] = [PACK_CLEAN, PACK_OD, PACK_DIST, PACK_SOLO]): LocalPreset[] {
  return names.map((n, i) => buildGroupPreset(base, 0, n, slots[i], undefined, gains[i]));
}

