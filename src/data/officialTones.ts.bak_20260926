const CAB_VOX = 'B&F NAM Vox AC30 Cab';
const AMP_ORANGE = 'B&F NAM Orange Rockerverb/Orange Rockerverb';
const CAB_ORANGE = 'B&F NAM Orange PPC 4x12';
const AMP_BOGNER = 'B&F NAM Bogner Ecstasy/Bogner Ecstasy';
const CAB_BOGNER = 'B&F NAM Bogner 2x12';
const AMP_EVH = 'B&F NAM EVH 5150III/EVH 5150III';
const CAB_EVH = 'B&F NAM EVH 5150 Cab';
const AMP_SVT = 'B&F NAM Ampeg SVT-CL/Ampeg SVT-CL';
const CAB_SVT = 'B&F NAM Ampeg SVT 8x10';
const AMP_HARTKE = 'B&F NAM Hartke/Hartke';
const CAB_HARTKE = 'B&F NAM Hartke 410';

// ─── 公共常量: 各箱头 EQ (与 16 槽内置库保持一致) ───
const TWIN_EQ = { GAIN: 0.1087, VOLUME: 1.0, MASTER: 0.75, BASS: 0.6, MIDDLE: 0.45, TREBLE: 0.5, PRESENCE: 0.4 };
const PLEXI_EQ = { GAIN: 0.1087, VOLUME: 1.0, MASTER: 0.75, BASS: 0.5, MIDDLE: 0.7, TREBLE: 0.5, PRESENCE: 0.55 };
const MESA_EQ = { GAIN: 0.1087, VOLUME: 1.0, MASTER: 0.75, BASS: 0.5, MIDDLE: 0.45, TREBLE: 0.6, PRESENCE: 0.65 };
const AC30_EQ = { GAIN: 0.1087, VOLUME: 1.0, MASTER: 0.75, BASS: 0.55, TREBLE: 0.5, CUT: 0.45 };
const ORANGE_EQ = { GAIN: 0.1087, VOLUME: 1.0, MASTER: 0.72, BASS: 0.55, MIDDLE: 0.5, TREBLE: 0.55, PRESENCE: 0.5 };
const BOGNER_EQ = { GAIN: 0.1087, VOLUME: 1.0, MASTER: 0.7, BASS: 0.5, MIDDLE: 0.5, TREBLE: 0.55, PRESENCE: 0.6 };
const EVH_EQ = { GAIN: 0.1087, VOLUME: 1.0, MASTER: 0.7, BASS: 0.5, MIDDLE: 0.45, TREBLE: 0.6, PRESENCE: 0.65, RESONANCE: 0.4 };
const SVT_EQ = { GAIN: 0.1087, VOLUME: 1.0, MASTER: 0.7, BASS: 0.6, MIDDLE: 0.55, TREBLE: 0.5, PRESENCE: 0.45 };
const HARTKE_EQ = { GAIN: 0.1087, VOLUME: 1.0, MASTER: 0.7, BASS: 0.55, MIDDLE: 0.55, TREBLE: 0.6, PRESENCE: 0.55 };

const COMP_GUITAR = { SUSTAIN: 0.35, OUTPUT: 0.4 };
const COMP_BASS = { COMPRESSION: 0.4, GAIN: 0.5 };
const DELAY_KNOBS = { TIME: 0.35, REPEAT: 0.3 };

interface MkBaseParams {
  mode?: 'guitar' | 'bass';
  amp: string;
  cab: string;
  od?: string;
  odKnobs?: Record<string, number>;
  dist?: string;
  distKnobs?: Record<string, number>;
  boost: number;
  ampKnobs: Record<string, number>;
  ng?: number;
  comp?: Record<string, number>;
  reverbModel?: 'Spring' | 'Hall';
  reverbMix?: number;
}

/** 组底座工厂: 主图全模块开启 (吉他含 delay/reverb), 每档只由 buildGroupPreset 覆盖 8 个 BYPASS 寄存器 */
function mkBase(p: MkBaseParams): GroupBase {
  const bass = p.mode === 'bass';
  const reverbModel = bass ? undefined : (p.reverbModel ?? 'Spring');
  const modules: Record<string, boolean> = {
    'noise-gate': true, boost: true, compressor: true,
    overdrive: !!p.od, dist: !bass && !!p.dist,
    'amp-head': true, cabinet: true, chorus: false,
    delay: !bass, reverb: !bass,
  };
  const subModels: Record<string, string> = {
    compressor: bass ? 'B&F 163' : 'B&F Dyna Comp',
    ...(p.od ? { overdrive: p.od } : {}),
    ...(!bass && p.dist ? { dist: p.dist } : {}),
    'amp-head': p.amp,
    cabinet: p.cab,
    ...(!bass ? { delay: 'Digital Delay', reverb: reverbModel! } : {}),
  };
  const knobs: Record<string, Record<string, number>> = {
    'noise-gate': { THRESHOLD: p.ng ?? (bass ? 0.3 : 0.4) },
    compressor: p.comp ?? (bass ? COMP_BASS : COMP_GUITAR),
    ...(p.od && p.odKnobs ? { overdrive: p.odKnobs } : {}),
    ...(!bass && p.dist && p.distKnobs ? { dist: p.distKnobs } : {}),
    'amp-head': p.ampKnobs,
    ...(!bass ? { delay: DELAY_KNOBS } : {}),
    ...(!bass ? {
      reverb: {
        'PRE-DELAY': 0.1,
        DECAY: reverbModel === 'Hall' ? 0.2 : 0.3,
        MIX: p.reverbMix ?? (reverbModel === 'Hall' ? 0.1 : 0.12),
        ...(reverbModel === 'Spring' ? { 'LOW CUT': 0.05 } : {}),
      },
    } : {}),
  };
  return { mode: bass ? 'bass' : 'guitar', boost: p.boost, modules, subModels, knobs };
}

// ─── 15 组底座 (4 原包 E/F/G/H + 11 新包) ───
const E_BASE = mkBase({ amp: AMP_VOX, cab: CAB_VOX, od: '轻过载/Klon Centaur', odKnobs: { GAIN: 0.5, TREBLE: 0.55, OUTPUT: 0.9 }, dist: '经典失真/DS-2', distKnobs: { DISTORTION: 0.55, TONE: 0.55, LEVEL: 0.88 }, boost: 0.4, ampKnobs: AC30_EQ, ng: 0.3, comp: { SUSTAIN: 0.4, OUTPUT: 0.6 }, reverbModel: 'Spring', reverbMix: 0.15 });
const F_BASE = mkBase({ amp: AMP_ORANGE, cab: CAB_ORANGE, od: '失真态过载/RAT', odKnobs: { DISTORTION: 0.5, FILTER: 0.55, VOLUME: 0.9 }, dist: '法兹/Big Muff', distKnobs: { DISTORTION: 0.6, SCOOP: 0.5, LEVEL: 0.9 }, boost: 0.5, ampKnobs: ORANGE_EQ, ng: 0.35, comp: { SUSTAIN: 0.4, OUTPUT: 0.6 }, reverbModel: 'Spring', reverbMix: 0.12 });
const G_BASE = mkBase({ amp: AMP_BOGNER, cab: CAB_BOGNER, od: '中频过载/OD808', odKnobs: { DRIVE: 0.5, TONE: 0.55, LEVEL: 0.9 }, dist: '锯条失真/HM-2', distKnobs: { DISTORTION: 0.6, HIGH: 0.5, LOW: 0.5, LEVEL: 0.9 }, boost: 0.5, ampKnobs: BOGNER_EQ, ng: 0.45, comp: { SUSTAIN: 0.35, OUTPUT: 0.6 }, reverbModel: 'Hall', reverbMix: 0.1 });
const H_BASE = mkBase({ amp: AMP_EVH, cab: CAB_EVH, od: '中频过载/Precision Drive', odKnobs: { DRIVE: 0.45, TREBLE: 0.5, VOLUME: 0.9 }, dist: '现代金属/MT-2', distKnobs: { DISTORTION: 0.55, MID: 0.45, LEVEL: 0.9 }, boost: 0.55, ampKnobs: EVH_EQ, ng: 0.5, comp: { SUSTAIN: 0.35, OUTPUT: 0.6 }, reverbModel: 'Hall', reverbMix: 0.08 });

