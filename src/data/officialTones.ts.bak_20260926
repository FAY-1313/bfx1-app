/**
 * 官方音色文件预置源 (v34 扩充).
 *
 * 音色库所有文件(含官方)均以"用户上传"形式落地: 官方内容由 seedOfficialTones()
 * (services/toneCommunity.ts) 以固定 _id 幂等写入云端 tones 集合, author='B&F core',
 * official:true, 与用户上传同池浏览. 本文件只定义官方内容的数据源.
 *
 * v34 内容: 15 官方组 + 30 官方单.
 *  - 15 组 = 原 4 组合包 (E Vox AC30 / F Orange / G Bogner / H EVH 5150III) + 11 新包
 *    (Fender Twin ×2 / Marshall Plexi ×2 / Mesa Recto ×2 / Vox AC30 / Bogner / Orange / Ampeg SVT / Hartke).
 *  - 30 单 = 原内置库代表音色 4 个 (复用 _id) + 26 个按风格新造 (清音7/过载7/失真7/主音2/贝斯3).
 * 每组 4 完整音色 (清音/过载/失真/SOLO, 贝斯为 清音/过载×3), 复用 buildGroupPreset 机制.
 */
import { buildGroupPreset, buildBuiltinPresets, B_BASE, GT_CLEAN_GUITAR, GT_OD_GUITAR, GT_DIST_GUITAR, GT_SOLO_GUITAR, GT_CLEAN_BASS, GT_OD_BASS } from './builtinPresets';
import type { GroupBase } from './builtinPresets';
import type { LocalPreset } from '../services/localPresets';

/** 官方文件固定 createdAt: 远未来时间戳 → orderBy createdAt desc 下官方恒排最前 */
const OFFICIAL_CREATED_AT = '2099-01-01T00:00:00.000Z';

export interface OfficialToneSeed {
  _id: string;
  kind: 'single' | 'group';
  name: string;
  description: string;
  tags: string[];
  category: 'guitar' | 'bass';
  data: LocalPreset;
  tones?: LocalPreset[];
  createdAt: string;
}

