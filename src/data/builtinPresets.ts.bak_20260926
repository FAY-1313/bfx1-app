/**
 * 预设1「空音色」所需的中性系统寄存器（A6 2026-09-23 补全）
 *   保证该档是一台"完整、确定"的中性直通链，而不是只写一半、其余留在硬件旧值上。
 */
const NEUTRAL_SYSTEM_REGS: Record<number, number> = {
  1: 3,        // 噪声门阈值默认
  2: 0,        // 吉他静音关
  3: 50,       // 输入音量 0dB
  // 239 (箱头 MASTER/PreMixer) 【不在本表】: 它属箱头模块参数 → 本档箱头关闭, 不写。
  //   2026-09-25 用户口径「239 算箱头模块参数（关闭即不写）」。
  254: 47, 255: 1, 256: 150, 257: 40, 258: 12, 259: 0,   // 限幅器 Off 档
  260: 0,      // 输出静音关
  261: 50,     // 输出音量 0dB
};

/**
 * 预设1: 默认空音色（A6 2026-09-23 修订）
 *
 * 旧版靠 10 个旁路位全 = 1 表达"全关"，但其中 7 个已被固件 R4 取消 → 无法再用旁路表达。
 * 新版改为"**全链直通**"：
 *   · 6 个直通类模块（压缩/过载/失真/箱头/箱体/混响）写入各自直通参数（PEQ 0dB + drive 最小）
 *   · 7 个被取消的模块总旁路位恒写 0（启用），6 个免写地址一律不出现
 *   · 仍有效的 3 个旁路位（噪声门0 / 合唱215 / 延迟221）写 1（旁路）
 *   · 系统/主输出/限幅器写中性值（NEUTRAL_SYSTEM_REGS）
 * 这样该档在硬件上是**完整且确定的中性直通链**，不再依赖残留值。
 */
export const BYPASS_PRESET: LocalPreset = (() => {
  const registers: Record<number, number> = { ...NEUTRAL_SYSTEM_REGS, 0: 1, 215: 1, 221: 1 };
  for (const mid of PASSTHROUGH_MODULES) Object.assign(registers, getModuleOffRegs(mid));
  applyWhitelistPolicy(registers);
  return {
    slot: 1,
    name: '默认空音色',
    playMode: 'guitar' as PlayMode,
    modules: G_MODULES_ALL_OFF,
    subModels: {},
    knobValues: { boost: { BOOST: 0 } },
    registers,
    savedAt: Date.UTC(2026, 7, 22),
  };
})();

