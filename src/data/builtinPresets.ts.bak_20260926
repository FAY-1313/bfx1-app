/**
 * 16 个内置预设音色 (v28 固定搭配分组, 与导出文档 预设文件音色1-16 同步)
 * 槽位: 1 默认空音色(全Bypass) + 2-4 A组(Fender Twin) + 5-8 B组(Marshall Plexi)
 *       + 9-12 C组(Mesa Dual Rectifier) + 13-16 D组贝斯: 13-14 Ampeg SVT-CL + 15-16 Hartke LH500.
 * 本地库为空时 (全新安装 / 清除应用数据) 自动写入, 不再按版本标记重灌. 每个预设 =
 * generatePresetRegisters 基线 (隐藏寄存器/旁路/PRE EQ/箱体捕获) + 旋钮覆盖.
 * v28 修订: B/C/D 箱头 GAIN 降 0.1087 (≤5dB 清音平台) + 15 槽音乐风格命名;
 * v28 修订2: D 组拆两组箱头箱体 (SVT-CL / Hartke), 无失真, slap 微量过载, 各档 BOOST 不同.
 * 过载/失真 subModels 用系列型号组合键 (如 "中频过载/TS808"), 见 seriesData.ts.
 *
 * 固定搭配分组 (v28): A/B/C 每组共用同一套 箱头/箱体/过载/失真 主寄存器图,
 * D 组分两套底座 (D1D2 SVT / D3D4 Hartke). 都只通过 8 个 BYPASS 寄存器
 * (7,42,57,72,107,215,221,224) 区分组内档位 —
 * A组 A2 清音 / A3 过载 / A4 失真SOLO; B/C/D 组 清音/过载/失真/失真SOLO (D 为 清音/过载/Slap/SlapPunch).
 * 切换时 Index.tsx diff-skip 只写变化的 BYPASS, 实现快速切换.
 *
 * 覆盖规则 (v18 音色架构):
 *  - BOOST 全开 + 噪音门全开: CLEAN boost≤0.4, 其他≤0.7; 噪音门阈值按类 (清音2/过载4/高增益5/贝斯3);
 *  - 箱头 VOLUME 全部 0~-3dB; GAIN 按通道封顶 (CLEAN≤5dB / 过载≤20dB / 高增益≤35dB);
 *  - 整体响度用各箱头 MASTER 逐箱配比 (清音 -9/-10 → 过载 -12~-14 → 高增益 -14~-16 → 贝斯 -10~-12);
 *  - 过载/失真吉他音色全部 = 过载/失真效果器 + 箱头 (8 条搭配互不相同, 不单独靠箱头);
 *  - 过载/失真踏板 VOLUME 0~-5dB; 逐音色独特箱头 EQ 塑形;
 *  - 其他参数匹配捕获值 (不覆盖基线).
 */
import { generatePresetRegisters } from '../services/presetEngine';
import { getLinkedParamDefs, getLegacyLinkedDefs, getParamDef } from '../data/parameterMap';
import { PASSTHROUGH_MODULES, MODULE_PARAM_RANGES, getModuleOffRegs, applyWhitelistPolicy } from './passThrough';
import { CABINET_PEQ } from '../data/cabinetPeqData';
import type { LocalPreset } from '../services/localPresets';
import type { PlayMode } from '../data/pedalData';

export interface BuiltinPresetSpec {
  slot: number;
  name: string;
  mode: PlayMode;
  modules: Record<string, boolean>;
  subModels: Record<string, string>;
  knobs: Record<string, Record<string, number>>;
  /** BOOST norm (PGA): CLEAN≤0.4, 其他≤0.7 */
  boost?: number;
}

/** 解析旋钮覆盖 → 覆盖 baseline 寄存器 (与 handleBleWrite 同一解析链) */
function setKnobValue(regs: Map<number, number>, moduleId: string, composed: string, knob: string, norm: number): void {
  const linkedDefs = (composed ? getLinkedParamDefs(composed, knob) : null) ?? getLegacyLinkedDefs(moduleId, knob);
  if (linkedDefs && linkedDefs.length > 0) {
    for (const linked of linkedDefs) {
      if (linked.regAddr === -1) continue;
      regs.set(linked.regAddr, typeof linked.compute === 'function'
        ? linked.compute(norm)
        : Math.round(norm * (linked.max - linked.min)) + linked.min);
    }
    return;
  }
  const def = getParamDef(moduleId, knob);
  if (def) regs.set(def.regAddr, Math.round(norm * (def.max - def.min)) + def.min);
}

export function buildBuiltinPreset(spec: BuiltinPresetSpec): LocalPreset {
  const engineModules: Record<string, boolean | string> = {
    ...spec.modules,
    'analog-delay': spec.modules['delay'] ?? false,
    compressorSubModel: spec.subModels['compressor'] ?? '',
    overdriveSubModel: spec.subModels['overdrive'] ?? '',
    distSubModel: spec.subModels['dist'] ?? '',
    ampHeadSubModel: spec.subModels['amp-head'] ?? '',
    chorusSubModel: spec.subModels['chorus'] ?? '',
  };
  // 箱体捕获 PEQ (默认第一个 capture), 无匹配 → 平坦中性兜底
  let cabPeq: number[] | undefined;
  const cabName = spec.subModels['cabinet'];
  if (cabName) {
    const cabKeys = Object.keys(CABINET_PEQ).filter((k) => k.startsWith(`${cabName}/`));
    const key = cabKeys.find((k) => !k.endsWith('_2')) ?? cabKeys[0];
    if (key) cabPeq = CABINET_PEQ[key];
  }
  const baseline = generatePresetRegisters(String(spec.slot), spec.name, spec.mode, engineModules, cabPeq);
  const regs = new Map<number, number>();
  for (const r of baseline) regs.set(r.regAddr, r.value);
  for (const [moduleId, knobs] of Object.entries(spec.knobs)) {
    const composed = spec.subModels[moduleId] ?? '';
    for (const [knob, norm] of Object.entries(knobs)) setKnobValue(regs, moduleId, composed, knob, norm);
  }
  const registers: Record<number, number> = {};
  for (const [addr, val] of regs) registers[addr] = val;
  return {
    slot: spec.slot,
    name: spec.name,
    playMode: spec.mode,
    modules: spec.modules,
    subModels: spec.subModels,
    // BOOST 无寄存器 (PGA): 存入 knobValues 供加载时 writePGA + 恢复旋钮显示
    knobValues: { boost: { BOOST: spec.boost ?? 0.4 } },
    registers,
    savedAt: Date.UTC(2026, 7, 22),
  };
}

export function buildBuiltinPresets(): LocalPreset[] {
  return [
    BYPASS_PRESET,               // slot 1: 默认空音色 (全 Bypass)
    buildGroupPreset(A_BASE, 2, 'A2 Twang Clean', A2_MODULES),
    // v29 同组箱头 GAIN 按音色区分 (A3 过载微破 / A4 主音给足), 切换 diff-skip 只写变化的 reg79
    buildGroupPreset(A_BASE, 3, 'A3 Blues Drive', A3_MODULES, undefined, { 'amp-head': { GAIN: 0.25 } }),
    buildGroupPreset(A_BASE, 4, 'A4 Twin Lead', A4_MODULES, undefined, { 'amp-head': { GAIN: 0.4348 } }),
    buildGroupPreset(B_BASE, 5, 'B1 Vintage Clean', GT_CLEAN_GUITAR),
    buildGroupPreset(B_BASE, 6, 'B2 Blues Crunch', GT_OD_GUITAR, undefined, { 'amp-head': { GAIN: 0.35 } }),
    buildGroupPreset(B_BASE, 7, 'B3 Classic Rock', GT_DIST_GUITAR, undefined, { 'amp-head': { GAIN: 0.55 } }),
    buildGroupPreset(B_BASE, 8, 'B4 Hot Lead', GT_SOLO_GUITAR, undefined, { 'amp-head': { GAIN: 0.65 } }),
    buildGroupPreset(C_BASE, 9, 'C1 Modern Clean', GT_CLEAN_GUITAR),
    buildGroupPreset(C_BASE, 10, 'C2 Thrash Crunch', GT_OD_GUITAR, undefined, { 'amp-head': { GAIN: 0.4 } }),
    buildGroupPreset(C_BASE, 11, 'C3 Heavy Metal', GT_DIST_GUITAR, undefined, { 'amp-head': { GAIN: 0.6 } }),
    buildGroupPreset(C_BASE, 12, 'C4 Shred Lead', GT_SOLO_GUITAR, undefined, { 'amp-head': { GAIN: 0.7 } }),
    buildGroupPreset(D_BASE_VINTAGE, 13, 'D1 Thump Clean', GT_CLEAN_BASS),
    buildGroupPreset(D_BASE_VINTAGE, 14, 'D2 Rock Drive', GT_OD_BASS, 0.6),
    buildGroupPreset(D_BASE_MODERN, 15, 'D3 Slap', GT_OD_BASS),
    // A6 (2026-09-23): D3/D4 原先寄存器完全相同(仅 boost 不同, 而 boost 是 PGA 非寄存器) →
    // 现给 D4 真实参数差异: OD drive 提高 + OD TREBLE 提亮 + 箱头 GAIN 抬到 0.2
    buildGroupPreset(D_BASE_MODERN, 16, 'D4 Slap Punch', GT_OD_BASS, 0.7,
      { overdrive: { DRIVE: 0.5, TREBLE: 0.65 }, 'amp-head': { GAIN: 0.2 } }),
  ];
}

// ─── 固定搭配分组 (A6 2026-09-23 修订) ───
// 每组共用同一主寄存器图; 档位差异不再靠"模块旁路位"(固件 R4 已取消 7 个),
// 而是: ① 不启用的直通类模块 → 写入该模块直通参数 ② 档位级旋钮覆盖(箱头 GAIN / OD drive 等)。
// 仍真实有效的旁路位只有 0(噪声门) / 215(合唱) / 221(延迟)。
export interface GroupBase {
  mode: PlayMode;
  boost: number;
  /** 主图模块: 全模块开启生成完整参数 (delay/reverb 按组需要) */
  modules: Record<string, boolean>;
  subModels: Record<string, string>;
  knobs: Record<string, Record<string, number>>;
}

// BYPASS 寄存器 → 模块键 (值: 0=开启 1=旁路)
// 2026-09-25 白名单口径: 7/42/57/72/107/224/253 已不可写 → 配置里不再出现；
//   直通类模块的开关改由内部旁路位 48/63/78 + PASSTHROUGH_REGS 承担（见 ① / applyWhitelistPolicy）。
//   此处仅保留仍真实有效的 3 个旁路位。
const LEGACY_BYPASS_ROWS: Array<[number, string]> = [
  [0, 'noise-gate'], [215, 'chorus'], [221, 'delay'],
];

/** 从共享主寄存器图构建固定搭配预设: 覆盖旁路位 + "关模块写直通参数" + 取消位归零. boost 可选覆盖底座默认值; knobsOverride 覆盖底座旋钮 (如同组不同档的箱头 GAIN) */
export function buildGroupPreset(base: GroupBase, slot: number, name: string, modules: Record<string, boolean>, boost?: number, knobsOverride?: Record<string, Record<string, number>>): LocalPreset {
  const full = buildBuiltinPreset({
    slot: 0, name: `${name} Base`, mode: base.mode, boost: boost ?? base.boost,
    modules: base.modules, subModels: base.subModels, knobs: base.knobs,
  });
  const registers: Record<number, number> = { ...full.registers };

  // ① 本档"不启用"的模块 → 只写该模块的关闭直通集（统一口径 = PASSTHROUGH_REGS）
  //    步骤: 先【整段删除】该模块自身参数(Drive/DC/Volume 等), 再写入直通集 ——
  //    PEQ 全段复位(0dB 直通) + OD/DIST/箱头 的内部旁路位 48/63/78 置 1。
  //    依据"关闭态口径"(2026-09-25): 关闭只写 9 个寄存器, 不写 49/50/51、64/65/66
  //    (该级已旁路, 写 Drive 无听感意义; 参数留到开启时随整图写入)。
  //    删除范围用 MODULE_PARAM_RANGES: 箱头是两段([72,104] + [239,239]),
  //    239(MASTER) 属箱头模块参数 → 箱头关闭即不写(2026-09-25 用户定)。
  for (const mid of PASSTHROUGH_MODULES) {
    if (modules[mid]) continue;
    for (const [lo, hi] of MODULE_PARAM_RANGES[mid] ?? []) {
      for (let a = lo; a <= hi; a++) delete registers[a];
    }
    Object.assign(registers, getModuleOffRegs(mid));
  }

  // ② 2026-09-25 白名单口径: 白名单外的地址一律从写入集中删除(不再"恒写 0")
  applyWhitelistPolicy(registers);

  // ③ 仍真实有效的旁路位 (噪声门0 / 合唱215 / 延迟221) 按模块开关写
  for (const [addr, mod] of LEGACY_BYPASS_ROWS) {
    registers[addr] = (modules[mod] ?? false) ? 0 : 1;
  }

  // ④ 档位级旋钮覆盖 (如箱头 GAIN 按音色区分): 走同一 setKnobValue 解析链写寄存器
  if (knobsOverride) {
    const regs = new Map<number, number>();
    for (const [k, v] of Object.entries(registers)) regs.set(parseInt(k), v);
    for (const [moduleId, knobs] of Object.entries(knobsOverride)) {
      const composed = base.subModels[moduleId] ?? '';
      for (const [knob, norm] of Object.entries(knobs)) setKnobValue(regs, moduleId, composed, knob, norm);
    }
    for (const [k, v] of regs) registers[k] = v;
  }
  return { ...full, slot, name, modules, registers };
}

