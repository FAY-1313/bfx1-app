  family: string;
  familyEn?: string;
  /** 真机面板旋钮（仅作参考文案，v10 起 UI 不再按此显隐） */
  realKnobs: string[];
  clip: { GAIN: number; DRIVE: number; VOL1: number; VOL2: number; DC1: number; DC2: number };
  knobs: AmpKnob[];      // N4 四个音色旋钮（逐台频点/Q-S 不同）
