  /** 短显示名（窄位用；完整名进列表副行） */
  sn?: string;
  cls: 'CLEAN' | 'CRUNCH' | 'HIGH-GAIN' | 'BASS' | 'CUSTOM';
  /** GAIN / DRIVE 旋钮上限（dB）：CLEAN 20 · CRUNCH 25 · HIGH-GAIN 40 · BASS 20 */
  limit: number;
  /**
   * ★ 2026-10-20：版本组标记。
   *   缺省 = 原 v10 内置 20 台；`'v19'` = 箱头重做总表 v19 的「新设计」组。
   *   首页型号弹窗据此把新箱头单独归到「NEW · 新箱头 v19」分组，与原有 20 台完全分开。
   */
