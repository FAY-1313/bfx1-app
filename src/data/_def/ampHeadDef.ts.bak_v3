/**
 * BFX1 箱头定义 · 三组试音色 + 原 v8 型号叠加（2026-10-12）
 *   前 3 条 = 三组试音色（clean/crunch/highgain，2026-10-12 用户交付）
 *   后 23 条 = 原 v8 型号（含 jcm800_2203，备份于 .bak_tone3groups）
 *
 * ⚠️ 本文件由 tools/_apply_tone_groups.py 生成，请勿手改。
 * 来源：三组试音色_CLEAN_CRUNCH_HIGHGAIN_20261012.md（2026-10-12 用户交付）
 * 编码：APK 口径（parameterMap.ts 的 PEQ 表 + 位域）
 *
 * 寄存器布局（ID 57–98）：
 *   57 整块旁通 | 58 N1库 | 59-62 N1 4段PEQ | 63 N2级
 *   64 GAIN | 65 DCOFFSET | 66 VOLUME1
 *   67 N4库 | 68-71 N4 4段PEQ
 *   72 整块旁通 | 73 N5库 | 74-77 N5 4段PEQ | 78 N6级
 *   79 DRIVE | 80 DCOFFSET2 | 81 VOLUME2
 *   82 N8库 | 83-98 N8 16段PEQ（前几段=旋钮段，其余=补偿段）
 *   MASTER = 239（块外，全局）
 *
 * 校验：编解码往返 + 文档交叉核对，全部通过
 */

export interface AmpKnob {
  name: string;        // TREBLE / BASS / MID / PRESENCE / RESONANCE / CUT
  addr: number;        // N8 段寄存器地址（83–98）
  seg: number;         // 段号 1–16
  typ: string;         // HighShelf / LowShelf / Peak
  hz: number;          // 中心/拐点频点
  qs: number;          // Q 或 S
  pfield: 'Q' | 'S';
}

export interface AmpModel {
  id: string;
  name: string;
  /** 短显示名（窄位用；完整名进列表副行） */
  sn?: string;
  cls: 'CLEAN' | 'CRUNCH' | 'HIGH-GAIN';
  /** GAIN / DRIVE 旋钮上限（dB）：CLEAN 20 · CRUNCH 30 · HIGH-GAIN 40 */
  limit: number;
  family: string;
  realKnobs: string[];   // 真机面板旋钮（参考）
  clip: { GAIN: number; DRIVE: number; VOL1: number; VOL2: number; DC1: number; DC2: number };
  knobs: AmpKnob[];      // ★ 每个型号的 N8 旋钮【数量与名称都不同】
  regs: Record<number, number>;
}

/** 箱头 MASTER（reg 239）· 全局，非型号参数 */
export const AMP_MASTER_ADDR = 239;
/** UI 只给 40 dB：reg 100…500 = −40.0…0.0 dB，步进 0.1 dB */
export const AMP_MASTER_MIN = 100;
export const AMP_MASTER_MAX = 500;
export const AMP_MASTER_DEF = 375;   // −12.5 dB

