/* ══════════════════════════════════════════════════════════════════════
 * ★ 2026-10-15 箱体精简（用户拍板）
 *
 *   只保留 3 个标准麦克风的【正方位】曲线：
 *     · 麦克风：SM57 / MD421 / M160
 *     · 同一箱体 + 同一麦克风只留 1 套，优先级 默认 > 位1 > Cap > 其余
 *   其余麦克风（C414 / R121 / e906 / i5 / SM7B / D6 / V7X / U67 / 4033 …）
 *   与所有其他录音位置（Cap Edge / Cone / Cone Edge / Enhanced / 位2..9 /
 *   LL·UL·UR 距离位 / 位置 A–E / 12in·24in Distant …）一律丢弃。
 *
 *   189 套 → 约 30 套。原数据完整保留在 RAW_CAB_SETS，如需回滚只需让
 *   CAB_SETS 直接等于 RAW_CAB_SETS。
 * ══════════════════════════════════════════════════════════════════════ */
const KEEP_MICS: readonly string[] = ['SM57', 'MD421', 'M160'];

/** 位置优先级：越小越"正方位" */
function posRank(p: string): number {
  if (p === '默认') return 0;
  if (p === '位1') return 1;
  if (p === 'Cap') return 2;
  if (p === '设计版') return 3;
  return 99;
}

export const CAB_SETS: CabSet[] = (() => {
  const best = new Map<string, CabSet>();
  for (const s of RAW_CAB_SETS) {
    /* ★ 2026-10-20 修复：设计版（mic = "IR 拟合"）必须保留。
       它们是为预设专门拟合的平滑曲线（1x12 开背 / 4x12 英式 / metal 4x12），
       原来被 KEEP_MICS 一并滤掉 → 预设里引用这些名字时 CAB_SETS.find 落空
       → cabPeq = undefined → 箱体写 35 段全平直（等于没开箱体）。
       实测已确认：那 4 条预设的低频比同类低 9 dB，正是"无箱体"的表现。 */
    const isDesign = s.mic === 'IR 拟合';
    if (!isDesign && !KEEP_MICS.includes(s.mic)) continue;
    const key = `${s.cab}||${s.category}||${s.mic}`;
    const cur = best.get(key);
    if (!cur || posRank(s.pos) < posRank(cur.pos)) best.set(key, s);
  }
  return [...best.values()];
})();

export const CAB_NAMES: string[] = Array.from(new Set(CAB_SETS.map(s => s.cab)));
